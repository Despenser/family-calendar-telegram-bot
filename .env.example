# Конфигурация базы данных PostgreSQL
DB_PASSWORD=your_secure_password_here

# Конфигурация Telegram бота
# Получите токен от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=YourBotUsername

# Webhook URL для получения обновлений от Telegram
# Для локальной разработки используйте ngrok: https://your-ngrok-url.ngrok.io/webhook/{botToken}
# Для production используйте ваш домен: https://yourdomain.com/webhook/{botToken}
TELEGRAM_BOT_WEBHOOK_URL=https://your-webhook-url.com/webhook

# Spring профиль (dev, test, prod)
SPRING_PROFILES_ACTIVE=prod
