# =============================================================================
# ПРИМЕР ФАЙЛА ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# =============================================================================
# Скопируйте этот файл в .env и заполните реальными значениями
# ВАЖНО: Файл .env не должен попадать в систему контроля версий!
# =============================================================================

# -----------------------------------------------------------------------------
# Spring Boot Configuration
# -----------------------------------------------------------------------------
# Активный профиль: dev, prod
SPRING_PROFILES_ACTIVE=dev

# Порт сервера (по умолчанию 8080)
SERVER_PORT=8080

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# URL подключения к базе данных
# Формат: jdbc:postgresql://host:port/database_name
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/family_calendar

# Имя пользователя БД
SPRING_DATASOURCE_USERNAME=botuser

# Пароль пользователя БД
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# Пароль для PostgreSQL (используется в docker-compose.yml)
DB_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# -----------------------------------------------------------------------------
# Токен бота от @BotFather
# Получить: https://t.me/BotFather -> /newbot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz1234567890

# Имя пользователя бота (без @)
TELEGRAM_BOT_USERNAME=FamilyCalendarBot

# URL для Webhook (должен быть доступен из интернета)
# Для локальной разработки используйте ngrok или localtunnel
# Формат: https://your-domain.com/webhook/{botToken}
TELEGRAM_BOT_WEBHOOK_URL=https://your-domain.com/webhook

# -----------------------------------------------------------------------------
# Development Environment (опционально для dev профиля)
# -----------------------------------------------------------------------------
# Токен тестового бота для разработки
TELEGRAM_BOT_TOKEN_DEV=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz1234567890

# Имя тестового бота
TELEGRAM_BOT_USERNAME_DEV=FamilyCalendarDevBot

# Webhook URL для разработки (ngrok)
# Пример: https://abc123.ngrok.io/webhook
TELEGRAM_BOT_WEBHOOK_URL_DEV=https://your-ngrok-url.ngrok.io/webhook

# -----------------------------------------------------------------------------
# Logging Configuration (опционально)
# -----------------------------------------------------------------------------
# Уровень логирования: TRACE, DEBUG, INFO, WARN, ERROR
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG

# -----------------------------------------------------------------------------
# Инструкции по настройке
# -----------------------------------------------------------------------------
# 1. Создайте бота через @BotFather в Telegram
# 2. Получите токен бота и сохраните его в TELEGRAM_BOT_TOKEN
# 3. Установите PostgreSQL или используйте Docker Compose
# 4. Создайте базу данных: CREATE DATABASE family_calendar;
# 5. Создайте пользователя БД: CREATE USER botuser WITH PASSWORD 'your_password';
# 6. Дайте права: GRANT ALL PRIVILEGES ON DATABASE family_calendar TO botuser;
# 7. Для локальной разработки настройте ngrok: ngrok http 8080
# 8. Скопируйте ngrok URL в TELEGRAM_BOT_WEBHOOK_URL
# 9. Запустите приложение: mvn spring-boot:run
#
# Для Docker Compose:
# 1. Заполните переменные в .env
# 2. Запустите: docker-compose up -d
# 3. Проверьте логи: docker-compose logs -f app
# -----------------------------------------------------------------------------
